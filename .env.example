# Copy to .env.local and fill in real values. Never commit .env.local.

# Mock layer toggle: true → in-browser demo data, false → real Express API
NEXT_PUBLIC_USE_MOCK_DATA=true

# Express API base (pizzahub-server), no trailing slash
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Better Auth origin (usually the same as the API base)
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:5000

# ImgBB key for menu-item / avatar uploads — https://api.imgbb.com
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key

# This site's own origin (used for OAuth callback URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
