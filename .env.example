# Copy to .env.local. This is the only variable the frontend needs.
#
# Render backend origin, no trailing slash. Empty = demo mode with the
# in-browser mock database.
NEXT_PUBLIC_API_URL=

# Optional. Absolute URL of THIS app (e.g. https://pizzahub-client-psi.vercel.app).
# Only used as the Better Auth base URL during server-side rendering; in the
# browser the current origin is used automatically. On Vercel it falls back to
# VERCEL_URL, and locally to http://localhost:3000.
# NEXT_PUBLIC_APP_URL=

# Example once the backend is live:
# NEXT_PUBLIC_API_URL=https://pizzahub-server.onrender.com
